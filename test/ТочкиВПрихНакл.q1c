<?xml version="1.0" encoding="UTF-8"?>
<querylist>
	<query name="ВЫБОР
		КОГДА НЕ ДокументПриходнаяНакладная">
		<text>   ВЫБРАТЬ   Первые 100
	ВЫБОР
		КОГДА НЕ ДокументПриходнаяНакладная.Контрагент.ВестиРасчетыПоДокументам
				ИЛИ ЕСТЬNULL(ФактОплаты.Сумма, 0) &lt;= 0
			ТОГДА -1
		КОГДА ЕСТЬNULL(ФактОплаты.СуммаОплаты, 0) + ЕСТЬNULL(ФактОплаты.СуммаАванса, 0) = 0
			ТОГДА 2
		КОГДА ЕСТЬNULL(ФактОплаты.СуммаОплаты, 0) + ЕСТЬNULL(ФактОплаты.СуммаАванса, 0) = ЕСТЬNULL(ФактОплаты.Сумма, 0)
			ТОГДА 0
		КОГДА ЕСТЬNULL(ФактОплаты.СуммаОплаты, 0) + ЕСТЬNULL(ФактОплаты.СуммаАванса, 0) &gt; ЕСТЬNULL(ФактОплаты.Сумма, 0)
			ТОГДА 7
		ИНАЧЕ 1
	КОНЕЦ КАК НомерКартинкиОплаты,
	ВЫБОР
		КОГДА ЕСТЬNULL(ФактОплаты.Сумма, 0) &gt; 0
			ТОГДА ВЫБОР
					КОГДА ФактОплаты.Сумма ЕСТЬ NULL
						ТОГДА &amp;НеУчитывается
					КОГДА ЕСТЬNULL(ФактОплаты.СуммаОплаты, 0) + ЕСТЬNULL(ФактОплаты.СуммаАванса, 0) - ЕСТЬNULL(ФактОплаты.Сумма, 0) &gt;= 0
						ТОГДА &amp;ОплаченПолностью
					КОГДА ЕСТЬNULL(ФактОплаты.СуммаОплаты, 0) + ЕСТЬNULL(ФактОплаты.СуммаАванса, 0) &gt; 0
						ТОГДА &amp;ОплаченЧастично
					ИНАЧЕ &amp;БезОплаты
				КОНЕЦ
		ИНАЧЕ &amp;НеУчитывается
	КОНЕЦ КАК СтатусОплаты,
	ЕСТЬNULL(ФактОплаты.Сумма, 0) - ЕСТЬNULL(ФактОплаты.СуммаОплаты, 0) - ЕСТЬNULL(ФактОплаты.СуммаАванса, 0) КАК КОплате,
	ВЫБОР
		КОГДА ДокументПриходнаяНакладная.Проведен
				И ЕСТЬNULL(ФактОплаты.Сумма, 0) &gt; 0
			ТОГДА ВЫРАЗИТЬ((ЕСТЬNULL(ФактОплаты.СуммаОплаты, 0) + ЕСТЬNULL(ФактОплаты.СуммаАванса, 0)) * 100 / ЕСТЬNULL(ФактОплаты.Сумма, 0) КАК ЧИСЛО(15, 2))
		ИНАЧЕ 0
	КОНЕЦ КАК ПроцентОплаты,
	ДокументПриходнаяНакладная.Ссылка КАК Ссылка,
	ДокументПриходнаяНакладная.ПометкаУдаления КАК ПометкаУдаления,
	ДокументПриходнаяНакладная.Номер КАК Номер,
	ДокументПриходнаяНакладная.Дата КАК Дата,
	ДокументПриходнаяНакладная.Проведен КАК Проведен,
	ДокументПриходнаяНакладная.ВидОперации КАК ВидОперации,
	ДокументПриходнаяНакладная.Организация КАК Организация,
	ДокументПриходнаяНакладная.Контрагент КАК Контрагент,
	ДокументПриходнаяНакладная.Договор КАК Договор,
	ДокументПриходнаяНакладная.ДокументОснование КАК ДокументОснование,
	ДокументПриходнаяНакладная.Заказ КАК Заказ,
	ДокументПриходнаяНакладная.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	ДокументПриходнаяНакладная.Ячейка КАК Ячейка,
	ДокументПриходнаяНакладная.ВключатьРасходыВСебестоимость КАК ВключатьРасходыВСебестоимость,
	ДокументПриходнаяНакладная.ВалютаДокумента КАК ВалютаДокумента,
	ДокументПриходнаяНакладная.НалогообложениеНДС КАК НалогообложениеНДС,
	ДокументПриходнаяНакладная.СуммаВключаетНДС КАК СуммаВключаетНДС,
	ДокументПриходнаяНакладная.НДСВключатьВСтоимость КАК НДСВключатьВСтоимость,
	ДокументПриходнаяНакладная.Курс КАК Курс,
	ДокументПриходнаяНакладная.Кратность КАК Кратность,
	ДокументПриходнаяНакладная.СуммаДокумента КАК СуммаДокумента,
	ДокументПриходнаяНакладная.ВидЦенКонтрагента КАК ВидЦенКонтрагента,
	ДокументПриходнаяНакладная.РегистрироватьЦеныПоставщика КАК РегистрироватьЦеныПоставщика,
	ДокументПриходнаяНакладная.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
	ДокументПриходнаяНакладная.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
	ДокументПриходнаяНакладная.Комментарий КАК Комментарий,
	ДокументПриходнаяНакладная.Подразделение КАК Подразделение,
	ДокументПриходнаяНакладная.Ответственный КАК Ответственный,
	ДокументПриходнаяНакладная.Автор КАК Автор,
	ДокументПриходнаяНакладная.ПоложениеЗаказаПоставщику КАК ПоложениеЗаказаПоставщику,
	ДокументПриходнаяНакладная.ДисконтнаяКарта КАК ДисконтнаяКарта,
	ДокументПриходнаяНакладная.ЧекККМ КАК ЧекККМ,
	ДокументПриходнаяНакладная.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	ДокументПриходнаяНакладная.МоментВремени КАК МоментВремени,
	СостоянияЭД.СостояниеЭДО КАК СостояниеВерсииЭД,
	ВЫБОР
		КОГДА НаличиеФайлов.ЕстьФайлы ЕСТЬ NULL
			ТОГДА 0
		КОГДА НаличиеФайлов.ЕстьФайлы
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ЕстьФайлы,
	ВЫБОР
		КОГДА ДокументПриходнаяНакладная.ПроверятьРасхожденияСВходящимДокументом
				И ДокументПриходнаяНакладная.ЕстьРасхождения
				И НЕ ДокументПриходнаяНакладная.ПолученыДокументыПодтверждающиеРасхождения
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК Расхождения,
	ВЫБОР
		КОГДА ДокументПриходнаяНакладная.ПроверятьРасхожденияСВходящимДокументом
				И ДокументПриходнаяНакладная.ЕстьРасхождения
				И НЕ ДокументПриходнаяНакладная.ПолученыДокументыПодтверждающиеРасхождения
			ТОГДА &amp;ЕстьРасхождения
		ИНАЧЕ &amp;НетРасхождений
	КОНЕЦ КАК ОтборРасхождения,
	NULL КАК СостояниеОригиналаПервичногоДокумента,
	ИСТИНА КАК ОбщееСостояние,
	0 КАК СостояниеОригиналПолучен,
	ВЫРАЗИТЬ("" КАК Строка(50)) КАК СостояниеГИСМТ,
	ЕСТЬNULL(СостоянияОригиналовПервичныхДокументов.Состояние, ЗНАЧЕНИЕ(Справочник.СостоянияОригиналовПервичныхДокументов.ПустаяСсылка)) КАК СостояниеОригинала
ИЗ
	Документ.ПриходнаяНакладная КАК ДокументПриходнаяНакладная
ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияЭД
		ПО (СостоянияЭД.СсылкаНаОбъект = ДокументПриходнаяНакладная.Ссылка)
ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФактОплатыДокументов КАК ФактОплаты
		ПО ДокументПриходнаяНакладная.Ссылка = ФактОплаты.Документ
ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
		ПО ДокументПриходнаяНакладная.Ссылка = НаличиеФайлов.ОбъектСФайлами
ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияОригиналовПервичныхДокументов КАК СостоянияОригиналовПервичныхДокументов
		ПО ДокументПриходнаяНакладная.Ссылка = СостоянияОригиналовПервичныхДокументов.Владелец
			И (СостоянияОригиналовПервичныхДокументов.ОбщееСостояние = ИСТИНА)
ГДЕ ДокументПриходнаяНакладная.ДАТА МЕЖДУ &amp;Дата1 и &amp;Дата2 //и ДокументПриходнаяНакладная.Контрагент.Код="00-000011"
</text>
		<parameters>
			<parameter name="БезОплаты" type="Строка" value="б\о"/>
			<parameter name="Дата1" type="Дата" value="2025-12-01T00:00:00"/>
			<parameter name="Дата2" type="Дата" value="2025-12-31T00:00:00"/>
			<parameter name="ЕстьРасхождения" type="Строка" value="есть расх"/>
			<parameter name="НетРасхождений" type="Строка" value="нет расх"/>
			<parameter name="НеУчитывается" type="Строка" value="не учит"/>
			<parameter name="ОплаченПолностью" type="Строка" value="опл пол"/>
			<parameter name="ОплаченЧастично" type="Строка" value="опл част"/>
		</parameters>
	</query>
</querylist>